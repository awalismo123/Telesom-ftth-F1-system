{
  "name": "telesom-ftth-f1-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor-tesseract.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "node scripts/vendor-tesseract.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "ocr:lab": "tsx scripts/ocr-lab.mts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc -b",
    "verify": "npm run typecheck && npm run test && npm run build && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.0",
    "tesseract.js-core": "^6.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jpeg-js": "^0.4.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
